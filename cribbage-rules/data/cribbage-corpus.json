    {
      "id": "counting-order-and-five-card-hand",
      "title": "Counting order and the five-card hand",
      "kind": "rule_paraphrase",
      "edition_ids": ["two-player-standard-en"],
      "topics": ["counting", "show", "order", "starter"],
      "summary": "After the play ends, the hands and crib are counted in this fixed order: non-dealer's hand first, then dealer's hand, then the dealer's crib last. Each of the three is scored as a five-card set: the four cards from the player's hand (or the crib) combined with the same starter card. The starter therefore contributes to all three counts.",
