    {
      "id": "play-go-and-thirty-one",
      "title": "'Go' and reaching exactly 31",
      "kind": "rule_paraphrase",
      "edition_ids": ["two-player-standard-en"],
      "topics": ["play", "go", "thirty-one", "pegging"],
      "summary": "If a player cannot add a card without pushing the running total past 31, they say 'Go' and the opponent pegs 1 for the Go. If the opponent can still play cards under 31 they do so before the reset. Landing on exactly 31 scores 2 (instead of 1 for the Go). Whoever plays the last card of a subsequence (that does not reach 31) also pegs 1 for the Go. After a Go or a 31, the count resets to zero and the player who did not play the last card leads next.",
      "source": {
        "url": "https://bicyclecards.com/how-to-play/cribbage",
        "section": "The Go",
