    {
      "id": "pegging-runs-and-foreign-cards",
      "title": "Pegging: runs and the 'foreign card' rule",
      "kind": "scoring_atom",
      "edition_ids": ["two-player-standard-en"],
      "topics": ["pegging", "run", "play"],
      "summary": "A run during the play is a stretch of three or more of the most recently played cards whose ranks (ignoring suit) form a consecutive sequence, in any order. A run of three pegs 3, a run of four pegs 4, and so on. The sequence is broken as soon as an unrelated 'foreign' card is played into it. So 8-7-7-6 does not form a run (the second 7 is foreign), but 9-6-8-7 does form a run of four because the last four cards can be rearranged into 6-7-8-9.",
      "source": {
        "url": "https://bicyclecards.com/how-to-play/cribbage",
        "section": "Pegging",
        "publisher": "Bicycle Cards",
        "rights_status": "original-paraphrase",
